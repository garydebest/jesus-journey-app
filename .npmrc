; devDependencies (tsx, esbuild) are required at build time to produce dist/.
; Render sets NODE_ENV=production during the build step, which makes plain
; `npm install` prune devDependencies (specifically breaks the tsx bin link
; here, since it resolves through the @esbuild-kit/esm-loader override).
; Force dev deps to always install regardless of NODE_ENV.
production=false
